NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://agency:agency@localhost:5432/agency_os
# Required in production: runtime LOGIN member of agency_app, different from DATABASE_URL owner.
# Keep DATABASE_URL exclusively for migrations and seed operations.
DATABASE_APP_URL=
# Set DATABASE_RUNTIME_ROLE=worker/readonly only for a dedicated process.
DATABASE_WORKER_URL=
DATABASE_READONLY_URL=
DATABASE_RUNTIME_ROLE=app
# One-time bootstrap inputs; do not keep these in the API/worker runtime environment.
DATABASE_RUNTIME_PASSWORD=
DATABASE_WORKER_PASSWORD=
DATABASE_OWNER_ROLE=agency_owner
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-32-char-minimum-secret-key
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
# log2(N) de scrypt para el hash de contrasenas. 17 = 128 MiB por hash (minimo
# OWASP con r=8, p=1). Bajarlo solo en desarrollo si el arranque de tests pesa.
PASSWORD_SCRYPT_LOG2N=17
VAULT_KEK=change-me-to-a-32-char-minimum-kek-value
CORS_ORIGINS=http://localhost:5173
# Comma-separated CIDRs of the only reverse-proxy hops allowed to supply forwarded IPs.
# Mandatory and non-empty in production; leave empty only for direct dev/test traffic.
TRUSTED_PROXY_CIDRS=
REQUIRE_SHIFT_FOR_AUTH=true
EXTENSION_ID=
TABLEAU_API_BASE_URL=
TABLEAU_AUTH_TOKEN=
AI_ENGINE_URL=
AI_ENGINE_TOKEN=
ROCKETCHAT_BASE_URL=
ROCKETCHAT_TOKEN=
ROCKETCHAT_USER_ID=
# Shared webhook secret, minimum 32 characters in production.
ROCKETCHAT_WEBHOOK_SECRET=
# Only for the one-time local/bootstrap seed; never commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
LOG_LEVEL=info
