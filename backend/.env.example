NODE_ENV=development
DEMO_USER_PASSWORD=SET_A_LOCAL_DEMO_PASSWORD
PORT=3000
DATABASE_URL=postgresql://agency:agency@localhost:5432/agency_os
DATABASE_OWNER_ROLE=agency_owner
DATABASE_APP_URL=
DATABASE_WORKER_URL=
DATABASE_READONLY_URL=
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-32-char-minimum-secret-key
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
PASSWORD_SCRYPT_LOG2N=17
VAULT_KEK=change-me-to-a-32-char-minimum-kek-value
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXY_CIDRS=
REQUIRE_SHIFT_FOR_AUTH=true
EXTENSION_ID=
LOG_LEVEL=info
# Optional: set both values together only when creating the first administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DATABASE_RUNTIME_PASSWORD=
BOOTSTRAP_IP_CIDR=127.0.0.1/32

ROCKETCHAT_BASE_URL=
ROCKETCHAT_TOKEN=
ROCKETCHAT_USER_ID=
ROCKETCHAT_WEBHOOK_SECRET=
ROCKETCHAT_BOT_TRIGGER=ayuda
BOT_KNOWLEDGE_API_URL=http://127.0.0.1:3000/api/v1
# Use a short-lived access token, or provide temporary admin login values below.
BOT_KNOWLEDGE_ADMIN_JWT=
BOT_KNOWLEDGE_ADMIN_EMAIL=
BOT_KNOWLEDGE_ADMIN_PASSWORD=


# Tableau ETL (FR-19). Only the worker signs in: a second sign-in with the same PAT
# ends the first session, so never reuse this PAT in Postman or the discovery tool.
# Leave the PAT empty to keep the ETL off; queued runs then fail as "not configured".
TABLEAU_API_BASE_URL=https://prod-uk-a.online.tableau.com
TABLEAU_API_VERSION=3.29
TABLEAU_SITE_CONTENT_URL=partnerdata
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=
