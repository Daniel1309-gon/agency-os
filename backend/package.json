{
  "name": "@agency-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file=.env dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:local": "node --env-file=.env dist/main.js",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:bootstrap-runtime": "node --env-file=.env scripts/db-bootstrap-runtime.mjs",
    "db:bootstrap-ip": "node --env-file=.env scripts/db-bootstrap-ip.mjs",
    "db:seed": "pnpm build && pnpm db:seed:run",
    "db:seed:run": "node --env-file-if-exists=.env dist/database/seeds/seed.js",
    "db:seed:demo": "pnpm db:seed && node --env-file=.env dist/database/seeds/demo-seed.js",
    "bot:knowledge:import": "pnpm build && node --env-file=.env dist/scripts/bot-knowledge-import.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
