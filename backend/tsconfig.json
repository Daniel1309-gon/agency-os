{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "declaration": false,
    "noEmit": true
  },
  "include": ["src", "drizzle.config.ts", "vitest.config.ts", "vitest.integration.config.ts"],
  "exclude": ["node_modules", "dist"]
}
