DOMAIN=app.example.com
# Imagenes publicadas en GHCR (workflow publish-images). Desplegar por digest:
# se obtiene con `docker buildx imagetools inspect <tag>` y se pega aqui.
AGENCY_OS_API_IMAGE=ghcr.io/daniel1309-gon/agency-os-api@sha256:replace-with-the-manifest-digest
AGENCY_OS_WEB_IMAGE=ghcr.io/daniel1309-gon/agency-os-web@sha256:replace-with-the-manifest-digest
AGENCY_OS_BACKUP_IMAGE=ghcr.io/daniel1309-gon/agency-os-backup@sha256:replace-with-the-manifest-digest
VITE_API_BASE_URL=https://app.example.com/api/v1
VITE_EXTENSION_ID=fcniigapdfcoigmnkhkcgmhlhjdledbo
VITE_LOCAL_AGENT_URL=http://127.0.0.1:45831

POSTGRES_USER=agency
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=agency_os

# Owner connection: used only by the ops container for migrations and seed.
# URL-encode reserved characters in the password (for example # becomes %23).
DATABASE_URL=postgresql://agency:replace-with-a-long-database-password@postgres:5432/agency_os
# Runtime connection: created by db-bootstrap-runtime.mjs after migrations.
DATABASE_APP_URL=postgresql://agency_runtime:replace-with-a-long-runtime-password@postgres:5432/agency_os
DATABASE_RUNTIME_ROLE=app
DATABASE_RUNTIME_PASSWORD=replace-with-the-same-long-runtime-password
DATABASE_OWNER_ROLE=agency_owner
REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-at-least-32-random-characters
VAULT_KEK=replace-with-at-least-32-random-characters
CORS_ORIGINS=https://app.example.com
# Cadena de confianza: Caddy (172.28.0.11) y cloudflared (172.28.0.10).
TRUSTED_PROXY_CIDRS=172.28.0.10/32,172.28.0.11/32
REQUIRE_SHIFT_FOR_AUTH=true
# El scheduler corre solo en el servicio worker; las APIs lo desactivan en compose.
JOBS_ENABLED=true
PASSWORD_SCRYPT_LOG2N=17
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
LOG_LEVEL=info
EXTENSION_ID=fcniigapdfcoigmnkhkcgmhlhjdledbo

# Token del túnel de Cloudflare (única entrada pública). Se crea en el panel
# Zero Trust del túnel `agency-os-prod` y no se imprime en logs.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-tunnel-token

# Worker con rol de BD de mínimos privilegios. db:bootstrap-worker crea el login
# `agency_worker_runtime` (miembro de `agency_worker`) y exige su contraseña.
DATABASE_WORKER_URL=postgresql://agency_worker_runtime:replace-with-a-long-worker-password@postgres:5432/agency_os
DATABASE_WORKER_PASSWORD=replace-with-the-same-long-worker-password

# Backups a Backblaze B2 (bucket con Object Lock). La clave de aplicación NO
# debe poder saltarse la retención; la passphrase de restauración se custodia
# fuera del VPS.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET=agency-os-backups
AWS_ACCESS_KEY_ID=replace-with-the-b2-key-id
AWS_SECRET_ACCESS_KEY=replace-with-the-b2-application-key
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-restore-passphrase
# URL de heartbeat (Healthchecks.io o equivalente): si no llega el ping de exito
# en 45 minutos, el monitor avisa. Opcional pero requerido para la alerta externa.
BACKUP_HEARTBEAT_URL=

ROCKETCHAT_BASE_URL=https://chat.example.com
ROCKETCHAT_TOKEN=replace-with-rocketchat-token
ROCKETCHAT_USER_ID=replace-with-rocketchat-user-id
ROCKETCHAT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# One-time bootstrap values. Keep them out of the api service after provisioning.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-admin-password
BOOTSTRAP_IP_CIDR=203.0.113.10/32
