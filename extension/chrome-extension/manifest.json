{
  "manifest_version": 3,
  "name": "Agency OS - Acceso seguro a TalkyTimes",
  "version": "1.0.0",
  "description": "Inicia sesiones autorizadas por Agency OS sin persistir ni exponer credenciales de TalkyTimes.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://talkytimes.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://talkytimes.com/*",
    "http://localhost:3000/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://app.agency-os.example/*",
      "http://localhost:5173/*"
    ]
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}
