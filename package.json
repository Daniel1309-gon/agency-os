{
  "name": "agency-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @agency-os/api dev",
    "build": "pnpm --filter @agency-os/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @agency-os/api drizzle-kit generate",
    "db:migrate": "pnpm --filter @agency-os/api drizzle-kit migrate",
    "db:studio": "pnpm --filter @agency-os/api drizzle-kit studio"
  },
  "devDependencies": {
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
