{
  "name": "agency-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @agency-os/shared build && pnpm --filter @agency-os/api build",
    "lint": "pnpm --filter @agency-os/shared lint && pnpm --filter @agency-os/api lint",
    "typecheck": "pnpm --filter @agency-os/shared typecheck && pnpm --filter @agency-os/api typecheck",
    "test": "pnpm --filter @agency-os/api test",
    "db:generate": "pnpm --filter @agency-os/api drizzle-kit generate",
    "db:migrate": "pnpm --filter @agency-os/api drizzle-kit migrate",
    "db:studio": "pnpm --filter @agency-os/api drizzle-kit studio",
    "backend:dev": "pnpm --dir backend dev",
    "backend:build": "pnpm --dir backend build",
    "backend:test": "pnpm --dir backend test:all",
    "frontend:dev": "pnpm --dir web-app dev",
    "frontend:build": "pnpm --dir web-app build",
    "extension:check": "pnpm --dir extension check",
    "tableau:discovery": "node tools/tableau-discovery.mjs"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
