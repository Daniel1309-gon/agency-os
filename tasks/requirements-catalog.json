    { "id": "OQ-06", "status": "OPEN", "question": "Zona horaria de las marcas Tableau", "owner": "Responsable Tableau del cliente", "dueDate": "2026-09-18", "blocks": ["MET-04", "MET-05"] },
    { "id": "OQ-07", "status": "OPEN", "question": "Frontera nocturna y pertenencia al periodo", "owner": "Clienta (decide) + Daniel (modela)", "dueDate": "2026-09-25", "blocks": ["MET-05", "PAY-04"] },
    { "id": "OQ-08", "status": "OPEN", "question": "Retención legal y operativa de auditoría y datos raw", "owner": "Clienta (decide) + Daniel (propone)", "dueDate": "2026-08-31", "blocks": ["SEC-08"] },
    { "id": "OQ-09", "status": "OPEN", "question": "Fórmulas exactas de pago, metas, bonos y eventos", "owner": "Clienta (decide) + Daniel (modela)", "dueDate": "2026-10-02", "blocks": ["PAY-02", "PAY-04"] },
    { "id": "OQ-10", "status": "RESOLVED", "question": "Cuenta de servicio, naming y reglas Rocket.Chat", "owner": "Clienta (credencial) + Daniel (integra)", "dueDate": "2026-08-28", "blocks": [], "resolution": "Cuenta de servicio agency.bot verificada contra chat.globalcompany.company. Los canales de cuadrilla son privados (GROUP); la membresía la administra el coordinador a mano y el backend solo detecta deriva, por lo que el PAT no necesita invitar ni expulsar; salir del canal quita el acceso al historial; la alerta urgente va por DM al coordinador. La sincronización automática de miembros sale del criterio de FR-36 por decisión del cliente. Ver ADR 0010." },
    { "id": "OQ-11", "status": "OPEN", "question": "Gates Feature 9 y FR-39 y límites permitidos", "owner": "Clienta (autoriza) + Daniel (ejecuta spike)", "dueDate": "2026-09-11", "blocks": ["INT-02", "INT-03"] },
    { "id": "OQ-12", "status": "RESOLVED", "question": "Topología HA, storage, RPO/RTO y proxies", "owner": "Daniel (diseño base aprobado para Entrega 1)", "dueDate": "2026-08-28", "blocks": [], "resolution": "Baseline de producción: dos API stateless detrás de LB gestionado, worker separado con lease en PostgreSQL, PostgreSQL HA con failover y PITR, Redis HA, object storage privado para exportes/raw, backup diario verificado, RPO máximo 5 min y RTO objetivo 30 min. TRUSTED_PROXY_CIDRS es obligatorio y fail-closed; los CIDR reales se parametrizan al desplegar." },
    { "id": "OQ-13", "status": "OPEN", "question": "Máximo real de perfiles concurrentes por PC y operador", "owner": "Daniel (mide) + clienta (facilita PC)", "dueDate": "2026-09-11", "blocks": ["INT-01", "QUA-02"] }
