  "openQuestions": [
    { "id": "OQ-01", "status": "RESOLVED", "question": "Facultades exactas de DIRECTOR_OPERATIVO frente a ADMIN", "owner": "Daniel (decide la matriz operativa documentada)", "dueDate": "2026-08-24", "blocks": [], "resolution": "ADMIN conserva usuarios, RBAC, seguridad, configuración y vault; DIRECTOR_OPERATIVO tiene visibilidad y operación global, sin esas facultades administrativas." },
    { "id": "OQ-02", "status": "RESOLVED", "question": "Alcance de Coordinador y jerarquía de reviews", "owner": "Daniel (decide la matriz operativa documentada)", "dueDate": "2026-08-24", "blocks": [], "resolution": "COORDINADOR opera únicamente sobre su cuadrilla vigente; puede revisar icebreakers de sus operadores. DIRECTOR_OPERATIVO y ADMIN revisan globalmente; OPERADOR solo crea, evalúa y publica los propios." },
    { "id": "OQ-03", "status": "OPEN", "question": "Reglas de breaks, score y aprobación", "owner": "Clienta (decide) + Daniel (coordina)", "dueDate": "2026-08-31", "blocks": ["OPS-06", "ICE-04"] },
